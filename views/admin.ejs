<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cyber Virtual Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: { 500: '#10b981', 600: '#059669' }
            }
          }
        }
      };
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <% if (page === 'login') { %>
      <div class="mx-auto flex min-h-screen max-w-6xl items-center justify-center px-4 py-8">
        <div class="grid w-full overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl lg:grid-cols-2">
          <div class="hidden bg-gradient-to-br from-emerald-50 via-white to-emerald-100 p-10 lg:flex lg:flex-col lg:justify-between">
            <div>
              <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-white px-3 py-1 text-sm font-semibold text-emerald-700">
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                Cyber Virtual
              </div>
              <h1 class="max-w-sm text-4xl font-semibold tracking-tight text-slate-900">Admin access</h1>
              <p class="mt-4 max-w-sm text-slate-600">Manage approvals, review transactions, update payment details, and adjust client credits securely.</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-700">
              <p class="font-semibold text-slate-900">Protected operations</p>
              <p class="mt-2">Only the Cyber Virtual admin account can approve or reject payment requests.</p>
            </div>
          </div>

          <div class="flex items-center justify-center p-6 sm:p-10">
            <div class="w-full max-w-md">
              <div class="mb-8 text-center">
                <h2 class="text-3xl font-bold text-slate-900">Admin login</h2>
                <p class="mt-2 text-sm text-slate-600">Use your secure administrator credentials.</p>
              </div>

              <% if (error) { %>
                <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= error %></div>
              <% } %>

              <form method="POST" action="/admin/login" class="space-y-5">
                <div>
                  <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email</label>
                  <input id="email" name="email" type="email" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none focus:border-emerald-500" value="admin@cybervirtual.ng" />
                </div>
                <div>
                  <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
                  <input id="password" name="password" type="password" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none focus:border-emerald-500" value="Power081" />
                </div>
                <button type="submit" class="w-full rounded-2xl bg-emerald-500 px-5 py-3.5 text-base font-semibold text-white hover:bg-emerald-600">Log in to dashboard</button>
              </form>
              <div class="mt-6 text-center text-sm text-slate-600">
                <a href="/auth/login" class="font-semibold text-emerald-600 hover:text-emerald-700">Client login</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <header class="mb-6 flex items-center justify-between rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
          <div>
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Admin</p>
            <h1 class="mt-1 text-2xl font-bold">Cyber Virtual Control Panel</h1>
          </div>
          <div class="flex items-center gap-3">
            <a href="/" class="rounded-2xl bg-emerald-500 px-4 py-2 font-medium text-white hover:bg-emerald-600">Back to app</a>
            <a href="/auth/logout" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2 font-medium text-slate-700">Logout</a>
          </div>
        </header>

        <div class="grid gap-6 lg:grid-cols-1">
          <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-bold">Users & balances</h2>
            <div class="mt-4 space-y-3">
              <% users.forEach((entry) => { %>
                <div class="admin-user-row flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 p-3" data-user-id="<%= entry._id %>">
                  <div>
                    <p class="font-semibold" data-admin-user-name><%= entry.name || 'Unnamed client' %></p>
                    <p class="text-sm text-slate-600"><%= entry.email %></p>
                    <p class="text-xs uppercase tracking-wide text-slate-500"><span data-admin-user-role><%= entry.role %></span><span data-admin-user-region><%= entry.preferredRegion ? ' · ' + entry.preferredRegion : '' %></span></p>
                  </div>
                  <div class="flex items-center gap-2"><span data-admin-user-balance class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700"><%= entry.creditBalance %> credits</span><button type="button" class="delete-user-btn rounded-xl bg-rose-100 px-3 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-200" data-id="<%= entry._id %>">Delete</button></div>
                </div>
              <% }); %>
            </div>
          </section>

        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-bold">Payment Checkout</h2>
            <form id="opaySettingsForm" class="mt-4 space-y-4">
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-700">Bank</label>
                <input id="opayBank" type="text" value="<%= opaySettings.bank %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-emerald-500" />
              </div>
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-700">Account number</label>
                <input id="opayAccountNumber" type="text" value="<%= opaySettings.accountNumber %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-emerald-500" />
              </div>
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-700">Account name</label>
                <input id="opayAccountName" type="text" value="<%= opaySettings.accountName %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-emerald-500" />
              </div>
              <button class="w-full rounded-2xl bg-emerald-500 px-4 py-3 font-semibold text-white hover:bg-emerald-600">Save payment details</button>
            </form>
            <div id="opayResult" class="mt-4 hidden rounded-2xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-700"></div>
          </section>

          <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-bold">Revenue overview</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Pending</p>
                <p class="mt-2 text-3xl font-bold text-slate-900"><%= transactions.filter((txn) => txn.status === 'pending').length %></p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Approved</p>
                <p class="mt-2 text-3xl font-bold text-slate-900"><%= transactions.filter((txn) => txn.status === 'completed').length %></p>
              </div>
            </div>
          </section>
        </div>

        <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
          <script type="application/json" id="adminSupportState"><%- JSON.stringify(supportMessages.map((thread) => ({ id: thread._id, status: thread.status, updatedAt: thread.updatedAt, messageCount: (thread.messages || []).length, reply: thread.reply }))) %></script>
          <h2 class="text-lg font-bold">Client support chat</h2>
          <div class="mt-4 space-y-4">
            <% if (!supportMessages.length) { %>
              <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">No client conversations yet.</div>
            <% } else { %>
              <% supportMessages.forEach((thread) => { %>
                <div class="admin-support-thread rounded-2xl border border-slate-200 bg-slate-50 p-4" data-support-id="<%= thread._id %>">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div><p class="font-semibold text-slate-900"><%= thread.user_id?.name || 'Unnamed client' %></p><p class="text-xs text-slate-500"><%= thread.user_id?.email || 'Unknown client' %> · <%= thread.subject %></p></div>
                  </div>
                  <div class="mt-3 space-y-2">
                    <% if (thread.messages && thread.messages.length > 0) { %>
                      <% thread.messages.forEach((entry) => { %><div class="rounded-xl border border-slate-200 <%= entry.sender === 'admin' ? 'bg-emerald-50' : 'bg-white' %> p-3 text-sm"><p class="font-semibold"><%= entry.sender === 'admin' ? 'Admin' : 'Client' %></p><p class="mt-1 text-slate-700"><%= entry.message %></p></div><% }); %>
                    <% } else { %>
                      <div class="rounded-xl border border-slate-200 bg-white p-3 text-sm"><%= thread.message %></div>
                      <% if (thread.reply) { %><div class="rounded-xl border border-slate-200 bg-emerald-50 p-3 text-sm"><p class="font-semibold">Admin</p><p class="mt-1 text-slate-700"><%= thread.reply %></p></div><% } %>
                    <% } %>
                  </div>
                  <form class="admin-support-reply-form mt-3 flex flex-col gap-2 sm:flex-row" data-support-id="<%= thread._id %>">
                    <input name="message" type="text" required placeholder="Reply to client" class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm" />
                    <button type="submit" class="rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-white">Reply</button>
                  </form>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <button type="button" class="admin-delete-support-thread rounded-xl bg-rose-100 px-3 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-200" data-support-id="<%= thread._id %>">Delete thread</button>
                    <button type="button" class="admin-delete-support-user rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100" data-user-id="<%= thread.user_id?._id || thread.user_id %>">Delete all chats for this client</button>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </section>

        <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
          <script type="application/json" id="adminTransactionState"><%- JSON.stringify(transactions.map((txn) => ({ id: txn._id, status: txn.status, credits: txn.credits, amount: txn.amount, timestamp: txn.timestamp }))) %></script>
          <h2 class="text-lg font-bold">Payment approvals</h2>
          <div class="mt-4 overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-600">
                  <th class="py-3 pr-4">User</th>
                  <th class="py-3 pr-4">Package</th>
                  <th class="py-3 pr-4">Amount</th>
                  <th class="py-3 pr-4">Reference</th>
                  <th class="py-3 pr-4">Status</th>
                  <th class="py-3 pr-4">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% transactionGroups.forEach((group) => { %>
                  <tr class="bg-slate-50"><td colspan="6" class="px-2 py-3 font-semibold text-slate-900">Client ID: <%= group.clientId %> <span class="ml-2 font-normal text-slate-500"><%= group.email %></span></td></tr>
                  <% group.transactions.forEach((txn) => { %>
                    <tr class="border-b border-slate-100">
                      <td class="py-3 pr-4"><%= group.clientId %></td>
                      <td class="py-3 pr-4"><%= txn.package_name || 'Credit pack' %> (<%= txn.displayCredits || 0 %> credits)</td>
                      <td class="py-3 pr-4">₦<%= Number(txn.amount || 0).toLocaleString() %></td>
                      <td class="py-3 pr-4"><%= txn.proof_reference || '—' %></td>
                      <td class="py-3 pr-4"><span class="rounded-full <%= txn.status === 'completed' ? 'bg-emerald-50 text-emerald-700' : txn.status === 'failed' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700' %> px-2 py-1 text-xs font-semibold"><%= txn.status.toUpperCase() %></span></td>
                      <td class="py-3 pr-4"><div class="flex flex-wrap gap-2"><button type="button" class="approve-btn rounded-xl bg-emerald-500 px-3 py-2 text-[11px] font-semibold text-white hover:bg-emerald-600" data-id="<%= txn._id %>">Confirm</button><button type="button" class="pend-btn rounded-xl bg-amber-100 px-3 py-2 text-[11px] font-semibold text-amber-700 hover:bg-amber-200" data-id="<%= txn._id %>">Pend</button><button type="button" class="fail-btn rounded-xl bg-rose-100 px-3 py-2 text-[11px] font-semibold text-rose-700 hover:bg-rose-200" data-id="<%= txn._id %>">Failed</button><button type="button" class="delete-btn rounded-xl bg-slate-200 px-3 py-2 text-[11px] font-semibold text-slate-700 hover:bg-slate-300" data-id="<%= txn._id %>">Delete</button></div></td>
                    </tr>
                  <% }); %>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    <% } %>

    <script src="/app.js"></script>
  </body>
</html>
