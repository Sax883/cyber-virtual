<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-white text-slate-900">
    <div class="flex min-h-screen items-center justify-center px-4">
      <div class="text-center">
        <p class="text-sm uppercase tracking-[0.18em] text-slate-500">404</p>
        <h1 class="mt-2 text-4xl font-bold">Page not found</h1>
        <p class="mt-3 text-slate-600">The page you were looking for no longer exists or moved.</p>
        <a href="/" class="mt-6 inline-block rounded-2xl bg-emerald-500 px-5 py-3 font-semibold text-white hover:bg-emerald-600">Back home</a>
      </div>
    </div>
  </body>
</html>
