<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cyber Virtual | Secure Access</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#ecfdf5',
                100: '#d1fae5',
                500: '#10b981',
                600: '#059669',
                700: '#047857',
                900: '#022c22',
              },
              slate: {
                950: '#020617'
              }
            }
          }
        }
      };
    </script>
    <style>
      body { background: #ffffff; color: #0f172a; }
      .shadow-soft { box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08); }
    </style>
  </head>
  <body class="min-h-screen bg-white">
    <div class="mx-auto flex min-h-screen max-w-6xl items-center justify-center px-4 py-8">
      <div class="grid w-full overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft lg:grid-cols-2">
        <div class="hidden bg-gradient-to-br from-emerald-50 via-white to-emerald-100 p-10 lg:flex lg:flex-col lg:justify-between">
          <div>
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-white px-3 py-1 text-sm font-semibold text-emerald-700">
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
              Cyber Virtual
            </div>
            <h1 class="max-w-sm text-4xl font-semibold tracking-tight text-slate-900">Secure social verification access for your online growth.</h1>
          </div>
          <div class="space-y-3 text-sm text-slate-700">
            <div class="rounded-2xl border border-slate-200 bg-white p-4">
              <p class="font-semibold text-slate-900">Live social platform support</p>
              <p>WhatsApp, Telegram, Facebook, Instagram, and more.</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4">
              <p class="font-semibold text-slate-900">Instant access flow</p>
              <p>Purchase balance, activate a number, and receive verification SMS immediately.</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-center p-6 sm:p-10">
          <div class="w-full max-w-md">
            <div class="mb-8 text-center">
              <h2 class="text-3xl font-bold text-slate-900"><%= mode === 'login' ? 'Welcome back' : 'Create account' %></h2>
              <p class="mt-2 text-sm text-slate-600">Access your virtual number dashboard.</p>
            </div>

            <% if (error) { %>
              <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= error %></div>
            <% } %>

            <form method="POST" action="<%= mode === 'login' ? '/auth/login' : '/auth/signup' %>" class="space-y-5">
              <% if (mode === 'signup') { %>
                <div>
                  <label for="name" class="mb-2 block text-sm font-medium text-slate-700">Name</label>
                  <input id="name" name="name" type="text" required maxlength="100" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none ring-0 transition focus:border-emerald-500 focus:bg-white" placeholder="Your full name" />
                </div>
              <% } %>
              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email</label>
                <input id="email" name="email" type="email" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none ring-0 transition focus:border-emerald-500 focus:bg-white" placeholder="name@example.com" />
              </div>

              <div>
                <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
                <input id="password" name="password" type="password" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none ring-0 transition focus:border-emerald-500 focus:bg-white" placeholder="••••••••" />
              </div>

              <button type="submit" class="w-full rounded-2xl bg-emerald-500 px-5 py-3.5 text-base font-semibold text-white transition hover:bg-emerald-600"> <%= mode === 'login' ? 'Log in' : 'Create account' %> </button>
            </form>

            <div class="mt-6 text-center text-sm text-slate-600">
              <%= mode === 'login' ? 'Need an account?' : 'Already have an account?' %>
              <a href="<%= mode === 'login' ? '/auth/signup' : '/auth/login' %>" class="ml-1 font-semibold text-emerald-600 hover:text-emerald-700"><%= mode === 'login' ? 'Sign up' : 'Log in' %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
